#
# PostgreSQL top level makefile
#
# GNUmakefile.in
#

subdir =
top_builddir = .
include $(top_builddir)/src/Makefile.global

$(call recurse,all install,src config)

docs:
	$(MAKE) -C doc all

$(call recurse,world,doc src config contrib external,all)

# build src/ before contrib/
world-contrib-recurse: world-src-recurse

# build src/ before external/
world-external-recurse: world-src-recurse

$(call recurse,world-bin,src config contrib external,all)

# build src/ before contrib/
world-bin-contrib-recurse: world-bin-src-recurse

# build src/ before external/
world-bin-external-recurse: world-bin-src-recurse

html man:
	$(MAKE) -C doc $@

install-docs:
	$(MAKE) -C doc install

$(call recurse,install-world,doc src config contrib external,install)

# build src/ before contrib/
install-world-contrib-recurse: install-world-src-recurse

# build src/ before external/
install-world-external-recurse: install-world-src-recurse

$(call recurse,install-world-bin,src config contrib external,install)

# build src/ before contrib/
install-world-bin-contrib-recurse: install-world-bin-src-recurse

# build src/ before external/
install-world-bin-external-recurse: install-world-bin-src-recurse

$(call recurse,installdirs uninstall init-po update-po,doc src config)

$(call recurse,coverage,doc src config contrib external)

# clean, distclean, etc should apply to contrib and external too, even though
# it's not built by default
$(call recurse,clean,doc contrib external src config)
clean:
	rm -rf tmp_install/ portlock/
# Garbage from autoconf:
	@rm -rf autom4te.cache/

# Important: distclean `src' last, otherwise Makefile.global
# will be gone too soon.
distclean:
	$(MAKE) -C doc $@
	$(MAKE) -C contrib $@
	$(MAKE) -C external $@
	$(MAKE) -C config $@
	$(MAKE) -C src $@
	rm -rf tmp_install/ portlock/
# Garbage from autoconf:
	@rm -rf autom4te.cache/
	rm -f config.cache config.log config.status GNUmakefile

check-tests: | temp-install
check polar-check check-tests installcheck polar-installcheck installcheck-parallel installcheck-tests: CHECKPREP_TOP=src/test/regress
check polar-check check-tests installcheck polar-installcheck installcheck-parallel installcheck-tests: submake-generated-headers
	$(MAKE) -C src/test/regress $@

$(call recurse,check-world,src/test src/pl src/interfaces contrib external src/bin src/tools/pg_bsd_indent,check)
$(call recurse,checkprep,  src/test src/pl src/interfaces contrib external src/bin)

$(call recurse,installcheck-world,src/test src/pl src/interfaces contrib external src/bin,installcheck)
$(call recurse,install-tests,src/test/regress,install-tests)

GNUmakefile: GNUmakefile.in $(top_builddir)/config.status
	./config.status $@

update-unicode: | submake-generated-headers submake-libpgport
	$(MAKE) -C src/common/unicode $@
	$(MAKE) -C contrib/unaccent $@


##########################################################################

distdir	= postgresql-$(VERSION)
dummy	= =install=

# git revision to be packaged
PG_GIT_REVISION = HEAD

GIT = git

dist: $(distdir).tar.gz $(distdir).tar.bz2

.PHONY: $(distdir).tar.gz $(distdir).tar.bz2

distdir-location:
	@echo $(distdir)

# Note: core.autocrlf=false is needed to avoid line-ending conversion
# in case the environment has a different setting.  Without this, a
# tarball created on Windows might be different than on, and unusable
# on, Unix machines.

$(distdir).tar.gz:
	$(GIT) -C $(srcdir) -c core.autocrlf=false archive --format tar.gz -9 --prefix $(distdir)/ $(PG_GIT_REVISION) -o $(abs_top_builddir)/$@

$(distdir).tar.bz2:
	$(GIT) -C $(srcdir) -c core.autocrlf=false -c tar.tar.bz2.command='$(BZIP2) -c' archive --format tar.bz2 --prefix $(distdir)/ $(PG_GIT_REVISION) -o $(abs_top_builddir)/$@

distcheck: dist
	rm -rf $(dummy)
	mkdir $(dummy)
	$(GZIP) -d -c $(distdir).tar.gz | $(TAR) xf -
	install_prefix=`cd $(dummy) && pwd`; \
	cd $(distdir) \
	&& ./configure --prefix="$$install_prefix"
	$(MAKE) -C $(distdir)
	$(MAKE) -C $(distdir) install
	$(MAKE) -C $(distdir) uninstall
	@echo "checking whether \`$(MAKE) uninstall' works"
	test `find $(dummy) ! -type d | wc -l` -eq 0
	$(MAKE) -C $(distdir) dist
# Room for improvement: Check here whether this distribution tarball
# is sufficiently similar to the original one.
	rm -rf $(distdir) $(dummy)
	@echo "Distribution integrity checks out."

headerscheck: submake-generated-headers
	$(top_srcdir)/src/tools/pginclude/headerscheck $(top_srcdir) $(abs_top_builddir)

cpluspluscheck: submake-generated-headers
	$(top_srcdir)/src/tools/pginclude/headerscheck --cplusplus $(top_srcdir) $(abs_top_builddir)

#
# POLAR
#
LAST_COMMIT = HEAD~1
PROVE_FLAGS = "--timer"

precheck-main: | temp-install
	$(MAKE) check-world EXTRA_TESTS=numeric_big PG_TEST_EXTRA='kerberos ssl' USE_MODULE_DB=1 PROVE_FLAGS="$(PROVE_FLAGS)"
	$(MAKE) installcheck-world EXTRA_TESTS=numeric_big PG_TEST_EXTRA='kerberos ssl' USE_MODULE_DB=1 NO_TAP_TESTS=1
	$(MAKE) polar-check PG_TEST_EXTRA='kerberos ssl' USE_MODULE_DB=1 PROVE_FLAGS="$(PROVE_FLAGS)"
	$(MAKE) polar-installcheck PG_TEST_EXTRA='kerberos ssl' USE_MODULE_DB=1 NO_TAP_TESTS=1

precheck: plcheck dccheck-lite precheck-main

covcheck: coverage-html
	$(top_srcdir)/src/tools/delta_coverage.pl -f coverage/delta_coverage.txt -p $(LAST_COMMIT)

stylecheck:
	@echo "| checking copyrights"
	$(top_srcdir)/src/tools/polar_copyright_check.pl -s -p $(LAST_COMMIT)
	@echo "| checking GUC short description"
	$(top_srcdir)/src/tools/polar_check_guc_short_desc.pl
	@echo "| checking external extensions Makefile ASCII order"
	$(top_srcdir)/src/tools/polar_sort_subdir.pl -f $(top_srcdir)/external/Makefile
	$(top_srcdir)/src/tools/polar_sort_subdir.pl -f $(top_srcdir)/src/tools/pgindent/exclude_file_patterns
	$(top_srcdir)/src/tools/polar_sort_subdir.pl -f $(top_srcdir)/src/tools/pgindent/perl_exclude_file_patterns
	$(top_srcdir)/src/tools/polar_sort_subdir.pl -f $(top_srcdir)/src/tools/polar_copyright_exclude_patterns
	$(top_srcdir)/src/tools/polar_sort_subdir.pl -f $(top_srcdir)/src/tools/polar_coverage_exclude_patterns
	@echo "| checking configure style"
	autoreconf
	@rm -rf autom4te.cache/
	@echo "| checking C style"
	$(top_srcdir)/src/tools/pgindent/pgindent .
	@echo "| checking Perl style"
	$(top_srcdir)/src/tools/pgindent/pgperltidy .

plcheck: | temp-install
	$(MAKE) -C src/test/polar_pl check PROVE_FLAGS="$(PROVE_FLAGS)"

dccheck-lite: | temp-install
	$(MAKE) -C src/test/polar_consistency check

dccheck: | temp-install
	# dccheck must run serially
	$(MAKE) -C src/test/polar_consistency check-all PROVE_FLAGS="--timer --failures"

# Datamax TAP suite. datamax-check-lite runs the smoke subset
# (001..003) for quick CI; datamax-check runs the full set.
datamax-check-lite: | temp-install
	$(MAKE) -C src/test/polar_datamax check \
		PROVE_FLAGS="$(PROVE_FLAGS)" \
		PROVE_TESTS="t/001_polar_datamax_feedback_xmin.pl t/002_polar_datamax_streaming_mode.pl t/003_polar_datamax_promote_standby.pl"

datamax-check: | temp-install
	$(MAKE) -C src/test/polar_datamax check PROVE_FLAGS="$(PROVE_FLAGS)"

# The ci-* targets run polar-check concurrently with check-world, so it cannot
# rely on check-world to set up the temporary installation.
polar-check: | temp-install

# Test suites run by CI: ci-quick covers most PostgreSQL and PolarDB tests,
# ci-full adds the complete consistency and DataMax suites. The polar suites
# contain the longest TAP tests, so they are listed before check-world: under
# make -jN they then start first instead of queueing behind every check-world
# subdirectory and ending up on the critical path. They must be .PHONY: make
# defers the non-phony ones until after check-world anyway.
ci-full: plcheck dccheck datamax-check check-world polar-check

ci-quick: plcheck dccheck-lite datamax-check-lite check-world polar-check

# PolarDB nodes in TAP tests use direct I/O for polar_datadir by default, so
# their reads and writes wait for the disk. On slow CI disks this makes tests
# stall behind the writes of concurrent ones, so ci-quick uses buffered I/O.
# ci-full keeps direct I/O.
ci-quick: export PG_TEST_POLAR_VFS_PROTOCOL = file

.PHONY: plcheck dccheck-lite datamax-check datamax-check-lite ci-full ci-quick

#
# POLAR end
#

.PHONY: dist distcheck docs install-docs world check-world install-world \
	installcheck-world headerscheck cpluspluscheck \
	covcheck precheck stylecheck dccheck
