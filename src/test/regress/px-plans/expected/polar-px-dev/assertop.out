-- For target queries optionally specify EXPLAIN (COSTS OFF, VERBOSE) option from outside
\getenv explain_only EXPLAIN_ONLY
\set opt_explain ''
\if :explain_only
    \set opt_explain 'EXPLAIN (COSTS OFF, VERBOSE)'
\endif
set polar_enable_px = 1;
-- simple SQL with assert
-- expect assertion failure because more than 1 row returned
:opt_explain select (select 1 union select 2);
                     QUERY PLAN                     
----------------------------------------------------
 Nested Loop Left Join
   Output: (1)
   Join Filter: true
   ->  Result
         Output: true
   ->  Assert
         Output: (1)
         Assert Cond: ((row_number() OVER (?)) = 1)
         ->  WindowAgg
               Output: row_number() OVER (?), (1)
               ->  GroupAggregate
                     Output: (1)
                     Group Key: (1)
                     ->  Sort
                           Output: (1)
                           Sort Key: (1)
                           ->  Append
                                 ->  Result
                                       Output: 1
                                 ->  Result
                                       Output: 2
 Optimizer: PolarDB PX Optimizer
(22 rows)

-- expect assertion failure because more than 1 row returned
:opt_explain select (select generate_series(1,5));
                              QUERY PLAN                              
----------------------------------------------------------------------
 Nested Loop Left Join
   Output: (generate_series(1, 5))
   Join Filter: true
   ->  Result
         Output: true
   ->  Assert
         Output: (generate_series(1, 5))
         Assert Cond: ((row_number() OVER (?)) = 1)
         ->  WindowAgg
               Output: row_number() OVER (?), (generate_series(1, 5))
               ->  Materialize
                     Output: (generate_series(1, 5))
                     ->  ProjectSet
                           Output: generate_series(1, 5)
                           ->  Result
                                 Output: true
 Optimizer: PolarDB PX Optimizer
(17 rows)

-- expect assertion pass
:opt_explain select (select generate_series(1,1)) as series;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Nested Loop Left Join
   Output: (generate_series(1, 1))
   Join Filter: true
   ->  Result
         Output: true
   ->  Assert
         Output: (generate_series(1, 1))
         Assert Cond: ((row_number() OVER (?)) = 1)
         ->  WindowAgg
               Output: row_number() OVER (?), (generate_series(1, 1))
               ->  Materialize
                     Output: (generate_series(1, 1))
                     ->  ProjectSet
                           Output: generate_series(1, 1)
                           ->  Result
                                 Output: true
 Optimizer: PolarDB PX Optimizer
(17 rows)

-- PX query over tables with assert
drop table if exists assert_test1;
NOTICE:  table "assert_test1" does not exist, skipping
create table assert_test1(id int);
insert into assert_test1(id) select generate_series(1, 1000) as id order by id desc;
analyze assert_test1;
-- expect assertion failure because more than 1 row returned
:opt_explain select * from assert_test1 where id = (select id from assert_test1);
                                      QUERY PLAN                                      
--------------------------------------------------------------------------------------
 Hash Join
   Output: assert_test1.id
   Hash Cond: (assert_test1.id = assert_test1_1.id)
   ->  PX Coordinator 2:1  (slice1; segments: 2)
         Output: assert_test1.id
         ->  Partial Seq Scan on public.assert_test1
               Output: assert_test1.id
   ->  Hash
         Output: assert_test1_1.id
         ->  Assert
               Output: assert_test1_1.id
               Assert Cond: ((row_number() OVER (?)) = 1)
               ->  WindowAgg
                     Output: row_number() OVER (?), assert_test1_1.id
                     ->  PX Coordinator 2:1  (slice2; segments: 2)
                           Output: assert_test1_1.id
                           ->  Partial Seq Scan on public.assert_test1 assert_test1_1
                                 Output: assert_test1_1.id
 Optimizer: PolarDB PX Optimizer
(19 rows)

-- expect assertion pass because only 1 row returned
:opt_explain select * from assert_test1 where id = (select id from assert_test1 where id = 1);
                                            QUERY PLAN                                            
--------------------------------------------------------------------------------------------------
 PX Coordinator 2:1  (slice1; segments: 2)
   Output: assert_test1.id
   ->  Hash Join
         Output: assert_test1.id
         Hash Cond: (assert_test1.id = assert_test1_1.id)
         ->  Partial Seq Scan on public.assert_test1
               Output: assert_test1.id
         ->  Hash
               Output: assert_test1_1.id
               ->  Assert
                     Output: assert_test1_1.id
                     Assert Cond: ((row_number() OVER (?)) = 1)
                     ->  PX Broadcast 1:2  (slice2)
                           Output: assert_test1_1.id, (row_number() OVER (?))
                           ->  WindowAgg
                                 Output: assert_test1_1.id, row_number() OVER (?)
                                 ->  PX Coordinator 2:1  (slice3; segments: 2)
                                       Output: assert_test1_1.id
                                       ->  Partial Seq Scan on public.assert_test1 assert_test1_1
                                             Output: assert_test1_1.id
                                             Filter: (assert_test1_1.id = 1)
 Optimizer: PolarDB PX Optimizer
(22 rows)

drop table if exists assert_test2;
NOTICE:  table "assert_test2" does not exist, skipping
create table assert_test2(id1 int, id2 int, id3 int, id4 int);
insert into assert_test2(id1, id2, id3, id4) select
    generate_series(1, 1000),
    generate_series(1, 1000),
    generate_series(1, 1000),
    generate_series(1, 1000);
analyze assert_test2;
-- expect assertion failure because more than 1 row returned
:opt_explain select * from assert_test2 where id2 = (select id3 from assert_test2);
                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Hash Join
   Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
   Hash Cond: (assert_test2.id2 = assert_test2_1.id3)
   ->  PX Coordinator 2:1  (slice1; segments: 2)
         Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
         ->  Partial Seq Scan on public.assert_test2
               Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
   ->  Hash
         Output: assert_test2_1.id3
         ->  Assert
               Output: assert_test2_1.id3
               Assert Cond: ((row_number() OVER (?)) = 1)
               ->  WindowAgg
                     Output: row_number() OVER (?), assert_test2_1.id3
                     ->  PX Coordinator 2:1  (slice2; segments: 2)
                           Output: assert_test2_1.id3
                           ->  Partial Seq Scan on public.assert_test2 assert_test2_1
                                 Output: assert_test2_1.id3
 Optimizer: PolarDB PX Optimizer
(19 rows)

-- expect assertion pass because only 1 row returned
:opt_explain select * from assert_test2 where id2 = (select id3 from assert_test2 where id4 = 1);
                                            QUERY PLAN                                            
--------------------------------------------------------------------------------------------------
 PX Coordinator 2:1  (slice1; segments: 2)
   Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
   ->  Hash Join
         Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
         Hash Cond: (assert_test2.id2 = assert_test2_1.id3)
         ->  Partial Seq Scan on public.assert_test2
               Output: assert_test2.id1, assert_test2.id2, assert_test2.id3, assert_test2.id4
         ->  Hash
               Output: assert_test2_1.id3
               ->  Assert
                     Output: assert_test2_1.id3
                     Assert Cond: ((row_number() OVER (?)) = 1)
                     ->  PX Broadcast 1:2  (slice2)
                           Output: assert_test2_1.id3, (row_number() OVER (?))
                           ->  WindowAgg
                                 Output: assert_test2_1.id3, row_number() OVER (?)
                                 ->  PX Coordinator 2:1  (slice3; segments: 2)
                                       Output: assert_test2_1.id3
                                       ->  Partial Seq Scan on public.assert_test2 assert_test2_1
                                             Output: assert_test2_1.id3
                                             Filter: (assert_test2_1.id4 = 1)
 Optimizer: PolarDB PX Optimizer
(22 rows)

-- More DML with assert to be test seperately...
reset all;
drop table assert_test1;
drop table assert_test2;
